pipeline {
    agent any

    environment {
        IMAGE_TAG = new Date().format('yyyy.MM.dd') + ".v${env.BUILD_NUMBER}"
        AWS_DEFAULT_REGION = credentials('AWS_REGION')
        ECR_REGISTRY = credentials('ECR_REGISTRY')
        S3_STATE_BUCKET = credentials('S3_STATE_BUCKET')
    }

    stages {
        stage('Login to ECR') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-keys'
                ]]) {
                    sh '''
                        aws ecr get-login-password --region $AWS_DEFAULT_REGION \
                        | docker login --username AWS --password-stdin $ECR_REGISTRY
                    '''
                }
            }
        }

        stage('Terraform Infra') {
            when {
                changeset "infrastructure/terraform/**"
            }
            steps {
                deployTerraform("terraform", S3_STATE_BUCKET, AWS_DEFAULT_REGION)
            }
        }

        stage('Build & Push Services') {
            parallel {
                stage('Go Service') {
                    when {
                        changeset "microservices/go-service/**"
                    }
                    steps {
                        buildMicroservice("go-service", "microservices/go-service", ECR_REGISTRY, IMAGE_TAG)
                    }
                }
                stage('Python Service') {
                    when {
                        changeset "microservices/python-service/**"
                    }
                    steps {
                        buildMicroservice("python-service", "microservices/python-service", ECR_REGISTRY, IMAGE_TAG)
                    }
                }
                stage('Rails Service') {
                    when {
                        changeset "microservices/rail-service/**"
                    }
                    steps {
                        buildMicroservice("rail-service", "microservices/rail-service", ECR_REGISTRY, IMAGE_TAG)
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
